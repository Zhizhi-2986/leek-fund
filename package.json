{
  "name": "leek-fund",
  "displayName": "韭菜盒子",
  "description": "韭菜盒子，VSCode 里也可以看股票实时数据，做个性化投资插件",
  "version": "3.24.0",
  "author": "Nicky Lao <giscafer@outlook.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/LeekHub/leek-fund"
  },
  "license": "BSD-3-Clause",
  "keywords": [
    "stock",
    "LeekFund",
    "股票",
    "韭菜盒子",
    "同花顺",
    "东方财富"
  ],
  "publisher": "giscafer",
  "icon": "resources/logo.png",
  "engines": {
    "vscode": "^1.59.0"
  },
  "enableProposedAPI": false,
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:leek-fund.refreshStock",
    "onCommand:leek-fund.stockWindVane",
    "onView:leekFundView.stock",
    "onView:leekFundView.news",
    "onView:leekFundView.binance",
    "onView:leekFundView.forex",
    "onView:leekFundView.settings",
    "onCommand:leek-fund.toggleStatusBarIconVisibility"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "leekFundMenu",
          "title": "LeekFund",
          "icon": "resources/leekfund.svg"
        }
      ]
    },
    "views": {
      "leekFundMenu": [
        {
          "id": "leekFundView.stock",
          "name": "Stock"
        },
        {
          "id": "leekFundView.news",
          "name": "XueQiu News"
        },
        {
          "id": "leekFundView.binance",
          "name": "Binance",
          "visibility": "hidden"
        },
        {
          "id": "leekFundView.forex",
          "name": "Forex",
          "visibility": "hidden"
        },
        {
          "id": "leekFundView.settings",
          "visibility": "visible",
          "name": "Settings"
        }
      ]
    },
    "commands": [
      {
        "command": "leek-fund.openAiConfig",
        "title": "Leek: 打开 AI 配置管理",
        "icon": "$(gear)"
      },
      {
        "command": "leek-fund.sortStock",
        "title": "升序/降序/不排序",
        "icon": {
          "light": "resources/light/sort.svg",
          "dark": "resources/dark/sort.svg"
        }
      },
      {
        "command": "leek-fund.addStock",
        "title": "添加股票",
        "icon": "$(add)"
      },
      {
        "command": "leek-fund.setStockPrice",
        "title": "设置股票成本价",
        "icon": {
          "light": "resources/light/amount.svg",
          "dark": "resources/dark/amount.svg"
        }
      },
      {
        "command": "leek-fund.leekCenterView",
        "title": "韭菜中心",
        "icon": "$(home)"
      },
      {
        "command": "leek-fund.refreshStock",
        "title": "刷新数据",
        "icon": "$(refresh)"
      },
      {
        "command": "leek-fund.setStockTop",
        "title": "股票置顶",
        "icon": {
          "light": "resources/light/top.svg",
          "dark": "resources/dark/top.svg"
        }
      },
      {
        "command": "leek-fund.setStockUp",
        "title": "股票上移",
        "icon": "$(arrow-up)"
      },
      {
        "command": "leek-fund.setStockDown",
        "title": "股票下移",
        "icon": "$(arrow-down)"
      },
      {
        "command": "leek-fund.deleteStock",
        "title": "删除股票"
      },
      {
        "command": "leek-fund.showStockInStatusBar",
        "title": "展示到状态栏轮播",
        "icon": "$(eye-closed)"
      },
      {
        "command": "leek-fund.hideStockFromStatusBar",
        "title": "取消状态栏轮播展示",
        "icon": "$(eye)"
      },
      {
        "command": "leek-fund.stockTrendPic",
        "title": "股票走势（图片版）"
      },
      {
        "command": "leek-fund.viewMoneyFlow",
        "title": "资金流向",
        "icon": {
          "light": "resources/light/flow.svg",
          "dark": "resources/dark/flow.svg"
        }
      },
      {
        "command": "leek-fund.refreshFollow",
        "title": "刷新关注列表",
        "icon": "$(refresh)"
      },
      {
        "command": "leek-fund.toggleFlashNews",
        "title": "启用/关闭 OUTPUT Flash News",
        "icon": {
          "light": "resources/light/news.svg",
          "dark": "resources/dark/news.svg"
        }
      },
      {
        "command": "leek-fund.addNews",
        "title": "添加关注雪球用户",
        "icon": "$(add)"
      },
      {
        "command": "leek-fund.viewUserTimeline",
        "title": "查看动态（无头像）"
      },
      {
        "command": "leek-fund.deleteUser",
        "title": "取消关注"
      },
      {
        "command": "leek-fund.addBinancePair",
        "title": "添加交易对",
        "icon": "$(add)"
      },
      {
        "command": "leek-fund.deletePair",
        "title": "删除交易对"
      },
      {
        "command": "leek-fund.refreshBinance",
        "title": "刷新数据",
        "icon": "$(refresh)"
      },
      {
        "command": "leek-fund.setPairTop",
        "title": "交易对置顶",
        "icon": {
          "light": "resources/light/top.svg",
          "dark": "resources/dark/top.svg"
        }
      },
      {
        "command": "leek-fund.refreshForex",
        "title": "刷新数据",
        "icon": "$(refresh)"
      },
      {
        "command": "leek-fund.toggleStatusBarVisibility",
        "title": "LeekFund: Toggle Status Bar Visibility"
      },
      {
        "command": "leek-fund.toggleStatusBarIconVisibility",
        "title": "LeekFund: Toggle Status Bar Icon Visibility"
      },
      {
        "command": "leek-fund.toggleStockBarVisibility",
        "title": "LeekFund: Toggle Stock Bar Visibility"
      },
      {
        "command": "leek-fund.binanceSort",
        "title": "升序/降序/不排序",
        "icon": {
          "light": "resources/light/sort.svg",
          "dark": "resources/dark/sort.svg"
        }
      },
      {
        "command": "leek-fund.xuangubaoNews",
        "title": "选股宝快讯",
        "icon": {
          "light": "resources/light/news.svg",
          "dark": "resources/dark/news.svg"
        }
      },
      {
        "command": "leek-fund.stockWindVane",
        "title": "选股风向标",
        "icon": "$(graph)"
      }
    ],
    "keybindings": [
      {
        "command": "leek-fund.toggleStatusBarVisibility",
        "key": "ctrl+alt+t",
        "mac": "cmd+alt+t"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "leek-fund.refreshStock",
          "when": "view == leekFundView.stock",
          "group": "navigation"
        },
        {
          "command": "leek-fund.sortStock",
          "when": "view == leekFundView.stock",
          "group": "navigation"
        },
        {
          "command": "leek-fund.addStock",
          "when": "view == leekFundView.stock",
          "group": "navigation"
        },
        {
          "command": "leek-fund.viewMoneyFlow",
          "when": "view == leekFundView.stock",
          "group": "navigation"
        },
        {
          "command": "leek-fund.leekCenterView",
          "when": "view == leekFundView.stock",
          "group": "navigation"
        },
        {
          "command": "leek-fund.setStockPrice",
          "when": "view == leekFundView.stock",
          "group": "navigation"
        },
        {
          "command": "leek-fund.refreshFollow",
          "when": "view == leekFundView.news",
          "group": "navigation"
        },
        {
          "command": "leek-fund.toggleFlashNews",
          "when": "view == leekFundView.news",
          "group": "navigation"
        },
        {
          "command": "leek-fund.addNews",
          "when": "view == leekFundView.news",
          "group": "navigation"
        },
        {
          "command": "leek-fund.refreshBinance",
          "when": "view == leekFundView.binance",
          "group": "navigation"
        },
        {
          "command": "leek-fund.addBinancePair",
          "when": "view == leekFundView.binance",
          "group": "navigation"
        },
        {
          "command": "leek-fund.binanceSort",
          "when": "view == leekFundView.binance",
          "group": "navigation"
        },
        {
          "command": "leek-fund.refreshForex",
          "when": "view == leekFundView.forex",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "leek-fund.setStockTop",
          "when": "view == leekFundView.stock && viewItem != category  && viewItem!=nodata",
          "group": "group1"
        },
        {
          "command": "leek-fund.setStockUp",
          "when": "view == leekFundView.stock && viewItem != category  && viewItem!=nodata",
          "group": "group1"
        },
        {
          "command": "leek-fund.setStockDown",
          "when": "view == leekFundView.stock && viewItem != category  && viewItem!=nodata",
          "group": "group1"
        },
        {
          "command": "leek-fund.stockTrendPic",
          "when": "view == leekFundView.stock  && viewItem != category && viewItem!=nodata",
          "group": "group2"
        },
        {
          "command": "leek-fund.setStockTop",
          "when": "view == leekFundView.stock && viewItem != category && viewItem!=nodata",
          "group": "inline"
        },
        {
          "command": "leek-fund.setStockUp",
          "when": "view == leekFundView.stock && viewItem != category && viewItem!=nodata",
          "group": "inline"
        },
        {
          "command": "leek-fund.setStockDown",
          "when": "view == leekFundView.stock && viewItem != category && viewItem!=nodata",
          "group": "inline"
        },
        {
          "command": "leek-fund.deleteStock",
          "when": "view == leekFundView.stock  && viewItem != category",
          "group": "group5"
        },
        {
          "command": "leek-fund.showStockInStatusBar",
          "when": "view == leekFundView.stock && viewItem == statusBarStockHidden",
          "group": "inline"
        },
        {
          "command": "leek-fund.hideStockFromStatusBar",
          "when": "view == leekFundView.stock && viewItem == statusBarStockVisible",
          "group": "inline"
        },
        {
          "command": "leek-fund.deletePair",
          "when": "view == leekFundView.binance  && viewItem != category",
          "group": "group0"
        },
        {
          "command": "leek-fund.setPairTop",
          "when": "view == leekFundView.binance",
          "group": "inline"
        },
        {
          "command": "leek-fund.setPairTop",
          "when": "view == leekFundView.binance",
          "group": "group1"
        },
        {
          "command": "leek-fund.viewUserTimeline",
          "when": "view == leekFundView.news",
          "group": "group0"
        },
        {
          "command": "leek-fund.deleteUser",
          "when": "view == leekFundView.news",
          "group": "group1"
        },
        {
          "command": "leek-fund.xuangubaoNews",
          "when": "view == leekFundView.news",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "properties": {
        "leek-fund.stocks": {
          "type": "array",
          "default": [
            "sh000001",
            "sh000300",
            "sh000016",
            "sh000688",
            "hk03690",
            "hk00700",
            "usr_ixic",
            "usr_dji",
            "usr_inx"
          ],
          "description": "配置需要监控的股票代码（建议通过界面新增）"
        },
        "leek-fund.stockPrice": {
          "type": "object",
          "default": {},
          "description": "股票持仓金额（不建议手填，格式错误影响功能）"
        },
        "leek-fund.stockHeldTipShow": {
          "type": "boolean",
          "default": false,
          "description": "是否开启股票持仓提示"
        },
        "leek-fund.binance": {
          "type": "array",
          "default": [
            "BTC_USDT",
            "ETH_USDT",
            "EOS_USDT"
          ],
          "description": "配置需要监控的交易对（建议通过界面新增）"
        },
        "leek-fund.stocksRemind": {
          "type": "object",
          "description": "股票涨跌提醒，支持价格、涨跌幅。"
        },
        "leek-fund.statusBarStock": {
          "type": "array",
          "default": [],
          "description": "状态栏轮播展示的股票；为空时不展示股票状态栏（建议通过界面选择设置，必须是在股票代码已设置存在）"
        },
        "leek-fund.interval": {
          "type": "number",
          "default": 5000,
          "description": "配置轮询请求最新数据的时间间隔，单位：毫秒（最小轮询间隔是3秒）"
        },
        "leek-fund.riseColor": {
          "type": "string",
          "default": "white",
          "description": "股票涨的颜色"
        },
        "leek-fund.fallColor": {
          "type": "string",
          "default": "#C9AD06",
          "description": "股票跌的颜色"
        },
        "leek-fund.hideStatusBarStock": {
          "type": "boolean",
          "default": false,
          "description": "是否隐藏股票状态栏"
        },
        "leek-fund.hideStatusBar": {
          "type": "boolean",
          "default": false,
          "description": "是否隐藏状态栏"
        },
        "leek-fund.hideStatusBarIcon": {
          "type": "boolean",
          "default": false,
          "description": "是否隐藏状态栏图标"
        },
        "leek-fund.newsUserIds": {
          "type": "array",
          "default": [
            "5124430882",
            "1287305957",
            "1632326933"
          ],
          "description": "雪球用户id（进入雪球用户首页，复制/u/后的数字即可，比如 https://xueqiu.com/u/5124430882 链接的 5124430882）"
        },
        "leek-fund.xueqiuCookie": {
          "type": "string",
          "default": "",
          "description": "由于防爬虫机制，需要用户设置雪球网站cookie"
        },
        "leek-fund.showEarnings": {
          "type": "number",
          "default": 1,
          "description": "显示/隐藏盈亏（1显示，0隐藏）"
        },
        "leek-fund.iconType": {
          "type": "string",
          "default": "arrow",
          "description": "股票涨跌图标（目前支持两种：arrow 和 food）"
        },
        "leek-fund.stockSort": {
          "type": "number",
          "default": 0,
          "description": "股票排序方式(0正常、1升序、-1倒序)"
        },
        "leek-fund.stockRemindSwitch": {
          "type": "number",
          "default": 1,
          "description": "打开/关闭提醒（1打开，0关闭）"
        },
        "leek-fund.stockKLineChartSwitch": {
          "type": "number",
          "default": 0,
          "description": "筹码分布K线图/常规k线图（1筹码分布K线图，0常规k线图）"
        },
        "leek-fund.labelFormat": {
          "type": "object",
          "default": {
            "statusBarLabelFormat": "「${name}」${price}  ${icon}（${percent}）",
            "sidebarStockLabelFormat": "${icon|padRight|4}${percent|padRight|11}${price|padRight|15}「${name}」"
          },
          "description": "修改底部状态栏、侧栏的显示格式。\n"
        },
        "leek-fund.immersiveBackground": {
          "type": "boolean",
          "default": true,
          "description": "沉浸式背景（仅适配暗色主题）"
        },
        "leek-fund.flash-news": {
          "type": "boolean",
          "default": false,
          "description": "开启快讯输出（查看 - 输出 - 韭菜盒子快讯）"
        },
        "leek-fund.expandAStock": {
          "type": "boolean",
          "default": true,
          "description": "默认展开A股"
        },
        "leek-fund.expandHKStock": {
          "type": "boolean",
          "default": false,
          "description": "默认展开港股"
        },
        "leek-fund.expandUSStock": {
          "type": "boolean",
          "default": false,
          "description": "默认展开美股"
        },
        "leek-fund.aiConfig": {
          "type": "object",
          "default": {
            "apiKey": "",
            "baseUrl": "",
            "model": ""
          },
          "description": "AI助手配置（OpenAI API密钥、基础URL和模型名称）"
        },
        "leek-fund.aiStockHistoryRange": {
          "type": "string",
          "default": "3m",
          "enum": [
            "1y",
            "6m",
            "3m",
            "1m",
            "1w"
          ],
          "enumDescriptions": [
            "1年",
            "6个月",
            "3个月",
            "1个月",
            "1周"
          ],
          "description": "个股 AI 分析所用的前复权日线历史区间（A 股：搜狐；港股：腾讯）"
        }
      }
    },
    "viewsWelcome": [
      {
        "view": "选股宝快讯、AI助手",
        "contents": "\n [📰 选股宝快讯、AI助手](command:leek-fund.xuangubaoNews)"
      },
      {
        "view": "leekFundView.stock",
        "contents": "无数据，请检查网络或添加股票"
      },
      {
        "view": "leekFundView.binance",
        "contents": "无数据，请检查网络或添加交易对"
      },
      {
        "view": "leekFundView.forex",
        "contents": "无数据，请检查网络"
      },
      {
        "view": "leekFundView.news",
        "contents": "无数据，请检查网络或添加关注用户"
      },
      {
        "view": "leekFundView.settings",
        "contents": "\n [🏠️ 韭菜中心](command:leek-fund.leekCenterView) \n [🤖️ AI助手配置](command:leek-fund.openAiConfig) \n [🎨个性定制](command:leek-fund.customSetting)\n[💰赞助插件](command:leek-fund.donate)\n[📄使用文档](https://github.com/LeekHub/leek-fund/issues/371)\n[📚投资交流](https://github.com/LeekHub/leek-fund/issues/19)\n源码[Github](https://github.com/LeekHub/leek-fund)"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "yarn run compile",
    "compile": "tsc -p ./",
    "postcompile": "yarn --cwd ./template-packages/leek-center run build",
    "lint": "eslint src --fix --ext ts  --ignore-path .gitignore",
    "watch": "tsc -watch -p ./",
    "pretest": "yarn run lint && yarn run compile",
    "test": "node ./out/_test/runTest.js",
    "deploy": "vsce publish --yarn",
    "package": "vsce package --yarn -o ./",
    "commitmsg": "commitlint -e $GIT_PARAMS",
    "release": "standard-version"
  },
  "config": {
    "commitizen": {
      "path": "cz-customizable"
    }
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run lint",
      "commit-msg": "npm run commitmsg"
    }
  },
  "lint-staged": {
    "src/**/*.{js,ts,tsx}": [
      "prettier --write",
      "eslint --fix --ext .js",
      "git add ."
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^11.0.0",
    "@commitlint/config-conventional": "^11.0.0",
    "@types/glob": "^7.1.1",
    "@types/lodash": "4.17.5",
    "@types/mocha": "^7.0.2",
    "@types/node": "^18.0.0",
    "@types/vscode": "1.59.0",
    "@types/ws": "^7.4.0",
    "@typescript-eslint/eslint-plugin": "^2.30.0",
    "@typescript-eslint/parser": "^2.30.0",
    "@vscode/test-electron": "^2.3.9",
    "cross-env": "^7.0.3",
    "eslint": "^6.8.0",
    "glob": "^7.1.6",
    "husky": "^4.3.0",
    "lint-staged": "^10.5.1",
    "mocha": "^7.1.2",
    "prettier": "^2.1.2",
    "standard-version": "^9.3.2",
    "typescript": "^5.0.0",
    "vsce": "^2.15.0",
    "vscode-test": "^1.3.0"
  },
  "dependencies": {
    "amplitude": "^5.1.4",
    "axios": "^0.19.2",
    "cheerio": "1.0.0",
    "compare-versions": "^3.6.0",
    "entities": "^4.5.0",
    "http-proxy-middleware": "^3.0.3",
    "iconv-lite": "^0.6.2",
    "lodash": "4.17.21",
    "moment": "^2.29.4",
    "moment-timezone": "^0.6.0",
    "openai": "^5.16.0",
    "public-ip": "^4.0.3",
    "ws": "^7.4.1"
  },
  "extensionKind": [
    "ui",
    "workspace"
  ]
}
