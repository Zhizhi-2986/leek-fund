{
  "name": "stockInfo",
  "displayName": "stockInfo",
  "description": "个人自用 VSCode 股票信息插件",
  "version": "0.1.0",
  "author": "Zhizhi",
  "repository": {
    "type": "git",
    "url": "https://github.com/LeekHub/leek-fund"
  },
  "license": "BSD-3-Clause",
  "keywords": [
    "stock",
    "LeekFund",
    "股票",
    "stockInfo",
    "同花顺",
    "东方财富"
  ],
  "publisher": "Zhizhi",
  "icon": "resources/logo.png",
  "engines": {
    "vscode": "^1.59.0"
  },
  "enableProposedAPI": false,
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:leek-fund.refreshStock",
    "onCommand:leek-fund.stockWindVane",
    "onView:leekFundView.stock",
    "onCommand:leek-fund.toggleStatusBarIconVisibility"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "leekFundMenu",
          "title": "LeekFund",
          "icon": "resources/leekfund.svg"
        }
      ]
    },
    "views": {
      "leekFundMenu": [
        {
          "id": "leekFundView.stock",
          "name": "Stock"
        }
      ]
    },
    "commands": [
      {
        "command": "leek-fund.addStock",
        "title": "添加股票",
        "icon": "$(add)"
      },
      {
        "command": "leek-fund.refreshStock",
        "title": "刷新数据",
        "icon": "$(refresh)"
      },
      {
        "command": "leek-fund.setStockTop",
        "title": "股票置顶",
        "icon": {
          "light": "resources/light/top.svg",
          "dark": "resources/dark/top.svg"
        }
      },
      {
        "command": "leek-fund.deleteStock",
        "title": "删除股票"
      },
      {
        "command": "leek-fund.showStockInStatusBar",
        "title": "展示到状态栏轮播",
        "icon": "$(eye-closed)"
      },
      {
        "command": "leek-fund.hideStockFromStatusBar",
        "title": "取消状态栏轮播展示",
        "icon": "$(eye)"
      },
      {
        "command": "leek-fund.setStockStatusBar",
        "title": "选择状态栏轮播股票"
      },
      {
        "command": "leek-fund.toggleStatusBarVisibility",
        "title": "LeekFund: Toggle Status Bar Visibility"
      },
      {
        "command": "leek-fund.toggleStatusBarIconVisibility",
        "title": "LeekFund: Toggle Status Bar Icon Visibility"
      },
      {
        "command": "leek-fund.toggleStockBarVisibility",
        "title": "LeekFund: Toggle Stock Bar Visibility"
      },
      {
        "command": "leek-fund.xuangubaoNews",
        "title": "选股宝快讯",
        "icon": {
          "light": "resources/light/news.svg",
          "dark": "resources/dark/news.svg"
        }
      },
      {
        "command": "leek-fund.stockWindVane",
        "title": "选股风向标",
        "icon": "$(graph)"
      },
      {
        "command": "leek-fund.customSetting",
        "title": "Leek: 快捷设置",
        "icon": "$(settings-gear)"
      }
    ],
    "keybindings": [
      {
        "command": "leek-fund.toggleStatusBarVisibility",
        "key": "ctrl+alt+t",
        "mac": "cmd+alt+t"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "leek-fund.showStockInStatusBar",
          "when": "false"
        },
        {
          "command": "leek-fund.hideStockFromStatusBar",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "leek-fund.refreshStock",
          "when": "view == leekFundView.stock",
          "group": "navigation"
        },
        {
          "command": "leek-fund.addStock",
          "when": "view == leekFundView.stock",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "leek-fund.setStockTop",
          "when": "view == leekFundView.stock && viewItem != category  && viewItem!=nodata",
          "group": "group1"
        },
        {
          "command": "leek-fund.setStockTop",
          "when": "view == leekFundView.stock && viewItem != category && viewItem!=nodata",
          "group": "inline"
        },
        {
          "command": "leek-fund.deleteStock",
          "when": "view == leekFundView.stock  && viewItem != category",
          "group": "group5"
        },
        {
          "command": "leek-fund.showStockInStatusBar",
          "when": "view == leekFundView.stock && viewItem == statusBarStockHidden",
          "group": "inline"
        },
        {
          "command": "leek-fund.hideStockFromStatusBar",
          "when": "view == leekFundView.stock && viewItem == statusBarStockVisible",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "properties": {
        "leek-fund.stocks": {
          "type": "array",
          "default": [
            "sh000001",
            "sh000300",
            "sh000016",
            "sh000688",
            "hk03690",
            "hk00700",
            "usr_ixic",
            "usr_dji",
            "usr_inx"
          ],
          "description": "配置需要监控的股票代码（建议通过界面新增）"
        },
        "leek-fund.stocksRemind": {
          "type": "object",
          "description": "股票涨跌提醒，支持价格、涨跌幅。"
        },
        "leek-fund.statusBarStock": {
          "type": "array",
          "default": [],
          "description": "状态栏轮播展示的股票；为空时不展示股票状态栏（建议通过界面选择设置，必须是在股票代码已设置存在）"
        },
        "leek-fund.interval": {
          "type": "number",
          "default": 5000,
          "description": "配置轮询请求最新数据的时间间隔，单位：毫秒（最小轮询间隔是3秒）"
        },
        "leek-fund.riseColor": {
          "type": "string",
          "default": "white",
          "description": "股票涨的颜色"
        },
        "leek-fund.fallColor": {
          "type": "string",
          "default": "#C9AD06",
          "description": "股票跌的颜色"
        },
        "leek-fund.hideStatusBarStock": {
          "type": "boolean",
          "default": false,
          "description": "是否隐藏股票状态栏"
        },
        "leek-fund.hideStatusBar": {
          "type": "boolean",
          "default": false,
          "description": "是否隐藏状态栏"
        },
        "leek-fund.hideStatusBarIcon": {
          "type": "boolean",
          "default": false,
          "description": "是否隐藏状态栏图标"
        },
        "leek-fund.iconType": {
          "type": "string",
          "default": "arrow",
          "enum": [
            "arrow",
            "arrow1",
            "none"
          ],
          "enumDescriptions": [
            "箭头图标（红涨绿跌）",
            "箭头图标（绿涨红跌）",
            "无图标"
          ],
          "description": "股票涨跌图标样式"
        },
        "leek-fund.stockRemindSwitch": {
          "type": "number",
          "default": 1,
          "description": "打开/关闭提醒（1打开，0关闭）"
        },
        "leek-fund.labelFormat": {
          "type": "object",
          "default": {
            "statusBarLabelFormat": "「${name}」${price} ${icon}（${percent}）"
          },
          "description": "修改底部状态栏显示格式。支持 ${name} ${price} ${icon} ${percent} 占位符"
        },
        "leek-fund.immersiveBackground": {
          "type": "boolean",
          "default": true,
          "description": "沉浸式背景（仅适配暗色主题）"
        },
        "leek-fund.expandAStock": {
          "type": "boolean",
          "default": true,
          "description": "默认展开A股"
        },
        "leek-fund.expandHKStock": {
          "type": "boolean",
          "default": false,
          "description": "默认展开港股"
        },
        "leek-fund.expandUSStock": {
          "type": "boolean",
          "default": false,
          "description": "默认展开美股"
        }
      }
    },
    "viewsWelcome": [
      {
        "view": "leekFundView.stock",
        "contents": "无数据，请检查网络或添加股票"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "postcompile": "npm --prefix ./template-packages/leek-center run build --ignore-scripts",
    "lint": "eslint src --fix --ext ts  --ignore-path .gitignore",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run lint && npm run compile",
    "test": "node ./out/_test/runTest.js",
    "deploy": "vsce publish --no-yarn",
    "package": "vsce package --no-yarn -o ./",
    "commitmsg": "commitlint -e $GIT_PARAMS",
    "release": "standard-version"
  },
  "config": {
    "commitizen": {
      "path": "cz-customizable"
    }
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run lint",
      "commit-msg": "npm run commitmsg"
    }
  },
  "lint-staged": {
    "src/**/*.{js,ts,tsx}": [
      "prettier --write",
      "eslint --fix --ext .js",
      "git add ."
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^11.0.0",
    "@commitlint/config-conventional": "^11.0.0",
    "@types/glob": "^7.1.1",
    "@types/lodash": "4.17.5",
    "@types/mocha": "^7.0.2",
    "@types/node": "^18.0.0",
    "@types/vscode": "1.59.0",
    "@types/ws": "^7.4.0",
    "@typescript-eslint/eslint-plugin": "^2.30.0",
    "@typescript-eslint/parser": "^2.30.0",
    "@vscode/test-electron": "^2.3.9",
    "cross-env": "^7.0.3",
    "eslint": "^6.8.0",
    "glob": "^7.1.6",
    "husky": "^4.3.0",
    "lint-staged": "^10.5.1",
    "mocha": "^7.1.2",
    "prettier": "^2.1.2",
    "standard-version": "^9.3.2",
    "typescript": "^5.0.0",
    "vsce": "^2.15.0",
    "vscode-test": "^1.3.0"
  },
  "dependencies": {
    "amplitude": "^5.1.4",
    "axios": "^0.19.2",
    "cheerio": "1.0.0",
    "compare-versions": "^3.6.0",
    "entities": "^4.5.0",
    "http-proxy-middleware": "^3.0.3",
    "iconv-lite": "^0.6.2",
    "lodash": "4.17.21",
    "moment": "^2.29.4",
    "moment-timezone": "^0.6.0",
    "public-ip": "^4.0.3",
    "ws": "^7.4.1"
  },
  "extensionKind": [
    "ui",
    "workspace"
  ]
}
